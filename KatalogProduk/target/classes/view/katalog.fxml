<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="760" prefWidth="1000" stylesheets="@styles/app.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.KatalogController">

    <top>
        <VBox spacing="8" styleClass="header">
            <Label styleClass="title" text="Katalog Produk" />
            <Label text="Isi form, pilih produk, lalu simpan atau ubah data." />

            <Label text="Nama produk" />
            <TextField fx:id="namaField" promptText="Nama produk" />

            <Label text="Harga (Rp)" />
            <TextField fx:id="hargaField" promptText="Contoh: 10000" />

            <Label text="Foto" />
            <ComboBox fx:id="fotoBox" maxWidth="Infinity" />

        <HBox spacing="10">
            <Button text="Simpan"
            onAction="#saveProduct"
            styleClass="button-primary" />

            <Button text="Update"
            onAction="#updateProduct"
            styleClass="button-primary" />

            <Button text="Delete"
            onAction="#deleteProduct"
            styleClass="button-primary" />
        </HBox>

            <Label fx:id="pesanLabel" />
            <Label fx:id="jumlahLabel" text="Jumlah produk: 0" />
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true">
            <content>
                <TilePane fx:id="katalogPane" alignment="TOP_LEFT" hgap="16" vgap="16" />
            </content>
        </ScrollPane>
    </center>

</BorderPane>
